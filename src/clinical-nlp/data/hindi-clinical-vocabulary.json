{
  "meta": {
    "language": "hi",
    "locale": "hi-IN",
    "version": "0.1.0-hackathon-scope",
    "note": "Hackathon-scoped starter set. Each concept carries the full schema (native script, romanized forms, colloquial phrases, negation/severity hooks) so the SAME structure scales to the full 1000+/language target later — you just add rows, you never change the engine.",
    "targetVsHackathon": {
      "symptoms": { "target": "1000+", "hereCount": 20 },
      "conditions": { "target": "1000+", "hereCount": 12 },
      "medications": { "target": "1000+", "hereCount": 18 }
    }
  },

  "negationTriggers": [
    "nahi", "nahin", "nai", "na", "koi nahi", "bilkul nahi", "nahi hai",
    "nahi hua", "nahi hui", "kabhi nahi", "abhi tak nahi"
  ],

  "temporalPatterns": [
    { "id": "days_since", "regex": "(\\d+)\\s*(din|dino|dinon)\\s*se", "unit": "days" },
    { "id": "weeks_since", "regex": "(\\d+)\\s*(hafte|hafton)\\s*se", "unit": "weeks" },
    { "id": "months_since", "regex": "(\\d+)\\s*(mahine|mahino|mahinon)\\s*se", "unit": "months" },
    { "id": "since_today", "regex": "aaj\\s*se", "unit": "days", "value": 0 },
    { "id": "since_yesterday", "regex": "kal\\s*se", "unit": "days", "value": 1 },
    { "id": "since_last_night", "regex": "raat\\s*se", "unit": "hours", "value": 12 },
    { "id": "since_last_week", "regex": "pichhle\\s*hafte\\s*se", "unit": "weeks", "value": 1 }
  ],

  "severityModifiers": [
    { "term": "halka", "level": "mild" },
    { "term": "thoda", "level": "mild" },
    { "term": "हल्का", "level": "mild" },
    { "term": "zyada", "level": "moderate" },
    { "term": "bahut", "level": "severe" },
    { "term": "bahut zyada", "level": "severe" },
    { "term": "bahut tez", "level": "severe" },
    { "term": "tez", "level": "moderate" },
    { "term": "asahniya", "level": "severe" },
    { "term": "bardasht nahi ho raha", "level": "severe" }
  ],

