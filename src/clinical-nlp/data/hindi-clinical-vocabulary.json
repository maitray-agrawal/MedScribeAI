      "action": "escalate_immediate"
    },
    {
      "id": "rf_severe_symptom_with_altered_consciousness",
      "description": "Any severe symptom plus altered consciousness/seizure — neurological emergency",
      "requiresAny": ["sym_altered_consciousness", "sym_seizure"],
      "action": "escalate_immediate"
    },
    {
      "id": "rf_gi_bleed",
      "description": "Blood in stool or vomit — possible GI bleed",
      "requiresAny": ["sym_blood_in_stool"],
      "action": "escalate_priority"
    },
    {
      "id": "rf_jaundice_with_vomiting",
